# ======================================================================
# LibreSpeed MVC - Environment Configuration
# ======================================================================

# --- Application ---
APP_ENV=local
APP_DEBUG=true

# --- Server & Timezone ---
TZ=Asia/Jakarta
WEBPORT=8080

# --- Portal Display ---
TITLE="My Speedtest Portal"
TAGLINE="HTML5 Network Speed Test"

# --- Frontend Design Mode ---
# MODE: dual (download+upload), download (only), upload (only)
MODE=dual
# USE_NEW_DESIGN: true = modern UI (home_modern.php), false = classic UI (home_classic.php)
USE_NEW_DESIGN=true

# ======================================================================
# DATABASE CONFIGURATION
# ======================================================================
# Supported types: sqlite, mysql, postgresql, mssql
# ! Only ONE type can be active at a time.
DB_TYPE=sqlite

# --- SQLite Settings ---
# ! Used ONLY when DB_TYPE=sqlite.
# ! Do NOT set DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS for SQLite.
DB_SQLITE_FILE=database.sqlite

# --- MySQL / PostgreSQL / MSSQL Shared Settings ---
# ! Used ONLY when DB_TYPE=mysql, postgresql, or mssql.
# ! Do NOT set DB_SQLITE_FILE when using these drivers.
# ! Default ports: mysql=3306, postgresql=5432, mssql=1433
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=speedtest
DB_USER=root
DB_PASS=

# --- MSSQL Specific ---
# ! Used ONLY when DB_TYPE=mssql. Ignored by all other drivers.
# ! When DB_MSSQL_WINDOWS_AUTH=true, DB_USER and DB_PASS are IGNORED.
DB_MSSQL_WINDOWS_AUTH=false
DB_MSSQL_TRUST_CERT=true

# ======================================================================
# TELEMETRY SETTINGS
# ======================================================================
# Master switch. When false, ALL telemetry settings below are IGNORED
# and no speedtest results will be stored.
TELEMETRY=true

# ! Used ONLY when TELEMETRY=true. Ignored when TELEMETRY=false.
SPEEDTEST_PASSWORD=
SPEEDTEST_EMAIL=

# ! TELEMETRY_OBFUSCATION and OBFUSCATION_SALT work as a pair.
# ! When TELEMETRY_OBFUSCATION=true, OBFUSCATION_SALT MUST be set.
# ! When TELEMETRY_OBFUSCATION=false, OBFUSCATION_SALT is IGNORED.
TELEMETRY_OBFUSCATION=false
OBFUSCATION_SALT=

# Redacts all IP addresses and hostnames from stored telemetry data.
TELEMETRY_REDACT_IP=false

# ======================================================================
# ISP & GeoIP LOOKUP
# ======================================================================
# ! IPINFO_APIKEY and IPINFO_OFFLINE_DB are independent fallback methods.
# ! If IPINFO_APIKEY is set, online lookup is attempted first.
# ! If online lookup fails (or key is empty), IPINFO_OFFLINE_DB is used.
IPINFO_APIKEY=
IPINFO_OFFLINE_DB=app/Config/country_asn.mmdb
